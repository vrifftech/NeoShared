<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#20242b">
  <meta name="description" content="@NEO_WASM_APP_NAME@ browser edition, compiled from C++ and wxWidgets to WebAssembly.">
  <title>@NEO_WASM_PAGE_TITLE@</title>
  <link rel="icon" type="image/svg+xml" href="@NEO_WASM_APP_SLUG@.svg">
  <link rel="manifest" href="site.webmanifest">
  <style>
    :root { color-scheme: light dark; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #20242b; }
    body { display: flex; flex-direction: column; }
    #neo-browser-bar {
      min-height: 36px; display: flex; align-items: center; gap: 10px; padding: 6px 10px;
      color: #e8ebef; background: #20242b; border-bottom: 1px solid #3b424c; z-index: 100000;
      font-size: 13px; user-select: none;
    }
    #neo-browser-bar img { width: 22px; height: 22px; }
    #neo-browser-bar strong { font-weight: 650; }
    #neo-browser-bar .spacer { flex: 1; }
    #neo-browser-bar .privacy { opacity: .72; white-space: nowrap; }
    #neo-app-host { position: relative; flex: 1; min-height: 0; overflow: hidden; background: #ececec; }
    #main-window, #window-container { position: absolute; inset: 0; }
    #main-window { z-index: 0; }
    #window-container { z-index: 1; pointer-events: none; }
    canvas.emscripten { border: 0 none; padding: 0; margin: 0; display: block; }
    #progress-container {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 14px; z-index: 99999; color: #e8ebef; background: #20242b;
    }
    #progress-card { width: min(520px, calc(100vw - 40px)); padding: 24px; border: 1px solid #48515e; border-radius: 10px; background: #292f38; }
    #progress-title { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; font-size: 19px; }
    #progress-title img { width: 40px; height: 40px; }
    #progress-text { min-height: 22px; }
    #progress-track { margin-top: 10px; width: 100%; height: 8px; overflow: hidden; border-radius: 5px; background: #15181d; }
    #progress-bar-position { width: 0; height: 100%; background: #72a7e7; transition: width .15s linear; }
    #progress-note { margin-top: 14px; opacity: .72; font-size: 12px; line-height: 1.45; }
    #fatal-error { color: #ff8f8f; white-space: pre-wrap; }
    @media (max-width: 720px) { #neo-browser-bar .privacy { display: none; } }
  </style>
</head>
<body>
  <div id="neo-browser-bar">
    <img src="@NEO_WASM_APP_SLUG@.svg" alt="">
    <strong>@NEO_WASM_APP_NAME@ @NEO_WASM_APP_VERSION@</strong>
    <span>WebAssembly preview</span>
    <a href="PORT_STATUS.txt" target="_blank" rel="noopener" style="color:#a9cdf5">Browser limitations</a>
    <span class="spacer"></span>
    <span class="privacy">Files are processed locally in this browser tab.</span>
  </div>
  <div id="neo-app-host">
    <div id="main-window"></div>
    <div id="window-container"></div>
    <div id="progress-container">
      <div id="progress-card">
        <div id="progress-title"><img src="@NEO_WASM_APP_SLUG@.svg" alt=""><span>Loading @NEO_WASM_APP_NAME@…</span></div>
        <div id="progress-text">Downloading WebAssembly…</div>
        <div id="progress-track"><div id="progress-bar-position"></div></div>
        <div id="progress-note">The first load can take longer. Browser preferences are stored locally.</div>
        <div id="fatal-error"></div>
      </div>
    </div>
  </div>
  <script>
    var mainWindow = document.getElementById('main-window');
    var statusElement = document.getElementById('progress-text');
    var progressElement = document.getElementById('progress-bar-position');
    var progressContainer = document.getElementById('progress-container');
    var fatalError = document.getElementById('fatal-error');
    var showError = function(msg) {
      console.error(msg);
      fatalError.textContent = String(msg);
      statusElement.textContent = 'Unable to start the application.';
    };
    var createCanvas = function() {
      var canvas = document.createElement('canvas');
      canvas.id = 'canvas';
      canvas.className = 'emscripten';
      canvas.style.display = 'none';
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.oncontextmenu = function(event) { event.preventDefault(); };
      canvas.addEventListener('webglcontextlost', function(event) {
        showError('WebGL context lost. Reload the page to continue.');
        event.preventDefault();
      }, false);
      mainWindow.appendChild(canvas);
      Module.canvas = canvas;
    };
    var Module = {
      preRun: [createCanvas],
      postRun: [],
      print: function(text) { console.log(Array.prototype.slice.call(arguments).join(' ')); },
      printErr: function(text) { console.error(Array.prototype.slice.call(arguments).join(' ')); },
      setStatus: function(text) {
        if (!text) return;
        var match = String(text).match(/([^(]+)\((\d+(?:\.\d+)?)\/(\d+)\)/);
        if (match) {
          statusElement.textContent = match[1].trim();
          progressElement.style.width = ((Number(match[2]) / Number(match[3])) * 100) + '%';
        } else {
          statusElement.textContent = text;
        }
      },
      totalDependencies: 0,
      monitorRunDependencies: function(left) {
        this.totalDependencies = Math.max(this.totalDependencies, left);
        Module.setStatus(left ? 'Preparing… (' + (this.totalDependencies - left) + '/' + this.totalDependencies + ')' : 'Starting…');
      },
      onRuntimeInitialized: function() {
        Module.canvas.style.display = 'block';
        progressContainer.style.display = 'none';
        window.dispatchEvent(new CustomEvent('neotools-wasm-ready', { detail: { app: '@NEO_WASM_APP_NAME@', version: '@NEO_WASM_APP_VERSION@' } }));
      },
      onAbort: function(reason) { showError(reason || 'WebAssembly aborted.'); }
    };
    Module.setStatus('Downloading WebAssembly…');
    window.addEventListener('error', function(event) {
      if (event && event.message) showError(event.message);
    });
    window.addEventListener('unhandledrejection', function(event) {
      showError(event && event.reason ? event.reason : 'Unhandled browser error.');
    });
  </script>
  {{{ SCRIPT }}}
</body>
</html>
